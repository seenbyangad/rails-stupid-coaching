<div class="container py-5">
  <div class="coach-card mx-auto">
    <h1 class="h3 mb-1">Stupid Coach</h1>
    <p class="text-muted mb-4">Ask your coach anything</p>

    <form action="/answer" data-turbo="false">
      <label for="question" class="form-label">Your question</label>
      <input type="text" id="question" name="question" class="form-control mb-3" placeholder="e.g. Should I go to work today?" autofocus>
      <input type="submit" value="Ask!" class="btn btn-dark w-100">
    </form>
  </div>
</div>
